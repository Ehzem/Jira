# Copy this file to .env and fill in the values.
# Keep .env private. Never upload or commit it.

JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=paste_token_here

# Optional: comma-separated project/space keys. Leave blank to export all visible projects.
JIRA_PROJECT_KEYS=

# Optional switches.
JIRA_INCLUDE_USERS=true
JIRA_INCLUDE_GROUP_MEMBERS=true
JIRA_INCLUDE_PROJECT_PROPERTIES=true
JIRA_INCLUDE_EPICS=true

# Optional browser-local Jira List-view state capture (Firefox).
# Keep true to preserve the source browser's List-view fields and order when available.
JIRA_INCLUDE_BROWSER_VIEW_STATE=true

# Optional: force a specific Firefox profile instead of automatic discovery.
# Windows example:
# JIRA_FIREFOX_PROFILE=C:\Users\YOUR_NAME\AppData\Roaming\Mozilla\Firefox\Profiles\xxxxxxxx.default-release


# Firefox List-view capture now includes localStorage, IndexedDB, and Jira-scoped sessionStorage.
# JIRA_FIREFOX_PROFILE=C:\\Users\\YOUR_NAME\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\xxxxxxxx.default-release
